<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Configurations>Debug;Release</Configurations>
    <RootNamespace>GridRoadGenerator</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- Doit rester alignée avec "version" dans UI/mod.json (numéro affiché dans Options >
         Mods > Sobre, via Mod.Version). -->
    <Version>0.4.1</Version>
  </PropertyGroup>

  <!-- Template officiel du toolchain de modding CS2 : Mod.props fournit TargetFramework,
       LangVersion, les chemins de résolution des DLL du jeu et les analyzers ECS ;
       Mod.targets fournit le post-processing (Burst) et le déploiement auto dans le
       dossier Mods locaux. Les imports doivent venir après le premier PropertyGroup. -->
  <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
  <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

  <ItemGroup>
    <!-- Sources décompilées de Game.dll : référence d'API uniquement, jamais compilées. -->
    <Compile Remove="decompiled\**" />
    <None Remove="decompiled\**" />
    <EmbeddedResource Remove="decompiled\**" />
    <!-- Mods open-source de référence (non versionnés, non compilés). -->
    <Compile Remove="reference\**" />
    <None Remove="reference\**" />
    <EmbeddedResource Remove="reference\**" />
    <!-- Tests unitaires : projet séparé (Tests/), jamais compilés dans la DLL du mod. -->
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <!-- Module UI (TypeScript) : buildé par webpack, pas par MSBuild. -->
    <None Remove="UI\node_modules\**" />
    <Content Remove="UI\node_modules\**" />
  </ItemGroup>

  <!-- Build du module UI (React/cohtml) après le déploiement de la DLL : webpack écrit
       GridRoadGenerator.mjs + .css directement dans le dossier Mods déployé.
       Pattern repris de CS2-NetworkTools (c) Luca Rager, MIT. -->
  <Target Name="BuildUI" AfterTargets="DeployWIP">
    <Message Text="[BuildUI] npm run build (UI/)" Importance="high" />
    <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)UI" />
  </Target>

  <ItemGroup>
    <Reference Include="Game"><Private>False</Private></Reference>
    <Reference Include="Colossal.Core"><Private>False</Private></Reference>
    <Reference Include="Colossal.Logging"><Private>False</Private></Reference>
    <Reference Include="Colossal.IO.AssetDatabase"><Private>False</Private></Reference>
    <Reference Include="Colossal.Localization"><Private>False</Private></Reference>
    <Reference Include="Colossal.Mathematics"><Private>False</Private></Reference>
    <Reference Include="Colossal.Collections"><Private>False</Private></Reference>
    <Reference Include="Colossal.UI.Binding"><Private>False</Private></Reference>
    <Reference Include="Unity.Burst"><Private>False</Private></Reference>
    <Reference Include="Unity.Collections"><Private>False</Private></Reference>
    <Reference Include="Unity.Entities"><Private>False</Private></Reference>
    <Reference Include="Unity.Mathematics"><Private>False</Private></Reference>
    <Reference Include="Unity.InputSystem"><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><Private>False</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Properties\PublishConfiguration.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
