<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GridRoadGenerator</AssemblyName>
    <RootNamespace>GridRoadGenerator</RootNamespace>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Adapte ce chemin vers ton dossier d'installation CS2 + son SDK de modding -->
    <CSIIPath Condition="'$(CSIIPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Cities Skylines II</CSIIPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Références typiques nécessaires à un mod CS2. Les noms/chemins exacts des DLL
         dépendent de ton installation ; utilise le Mod SDK officiel (paquet NuGet
         "Cities2Modding" ou équivalent, référencé par la communauté de modding CS2)
         plutôt que de les recopier à la main si possible. -->
    <Reference Include="Game">
      <HintPath>$(CSIIPath)\Cities2_Data\Managed\Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Core">
      <HintPath>$(CSIIPath)\Cities2_Data\Managed\Colossal.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Entities">
      <HintPath>$(CSIIPath)\Cities2_Data\Managed\Unity.Entities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(CSIIPath)\Cities2_Data\Managed\Unity.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Ajoute ici les autres DLL du jeu nécessaires (Unity.InputSystem, Colossal.IO.AssetDatabase, etc.) -->
  </ItemGroup>

</Project>
