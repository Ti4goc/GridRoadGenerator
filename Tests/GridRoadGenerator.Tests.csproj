<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests de la logique pure (Core/) : même TFM que le mod (net48, C# 9, cf. Mod.props).
       GridGenerator.cs est compilé directement (lien source) pour ne pas dépendre de la
       DLL du mod ni des assemblies du jeu — seule Unity.Mathematics est nécessaire,
       résolue depuis l'installation du jeu via CSII_MANAGEDPATH (posée par le toolchain). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>GridRoadGenerator.Tests</RootNamespace>
    <CSIIManagedPath>$([System.Environment]::GetEnvironmentVariable('CSII_MANAGEDPATH', 'EnvironmentVariableTarget.User'))</CSIIManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Core\GridGenerator.cs" Link="Core\GridGenerator.cs" />
    <Compile Include="..\Core\GridGenerator.Tree.cs" Link="Core\GridGenerator.Tree.cs" />
    <Compile Include="..\Core\GridGenerator.Organic.cs" Link="Core\GridGenerator.Organic.cs" />
    <Compile Include="..\Core\GridGenerator.Contour.cs" Link="Core\GridGenerator.Contour.cs" />
    <Compile Include="..\Core\GridGenerator.PedestrianLinks.cs" Link="Core\GridGenerator.PedestrianLinks.cs" />
    <Compile Include="..\Core\GridGenerator.Mixed.cs" Link="Core\GridGenerator.Mixed.cs" />
    <Compile Include="..\Core\NetworkGraph.cs" Link="Core\NetworkGraph.cs" />
    <Compile Include="..\Core\ConcentricGenerator.cs" Link="Core\ConcentricGenerator.cs" />
    <Compile Include="..\Core\FreeAreaPerimeter.cs" Link="Core\FreeAreaPerimeter.cs" />
    <Compile Include="..\Core\BrushMask.cs" Link="Core\BrushMask.cs" />
    <Compile Include="..\Localization\TipTranslations*.cs" Link="Localization\%(Filename)%(Extension)" />
    <Compile Include="..\Localization\TreeTranslations.cs" Link="Localization\TreeTranslations.cs" />
    <Compile Include="..\Localization\OrganicTranslations.cs" Link="Localization\OrganicTranslations.cs" />
    <Compile Include="..\Localization\ContourTranslations.cs" Link="Localization\ContourTranslations.cs" />
    <Compile Include="..\Localization\FreeAreaTranslations.cs" Link="Localization\FreeAreaTranslations.cs" />
    <Compile Include="..\Localization\RoundaboutTranslations.cs" Link="Localization\RoundaboutTranslations.cs" />
    <Compile Include="..\Localization\ToolsTranslations.cs" Link="Localization\ToolsTranslations.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(CSIIManagedPath)\Unity.Mathematics.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
